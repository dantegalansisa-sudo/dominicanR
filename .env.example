# Google Places API (New) — solo servidor. Sin prefijo VITE_ para que Vite
# nunca la incluya en el bundle del navegador.
GOOGLE_PLACES_API_KEY=

# Resend, para el formulario de contacto y las reservas.
RESEND_API_KEY=
CONTACT_TO=dominicanroutes@gmail.com
CONTACT_FROM=Dominican Routes <onboarding@resend.dev>

# PayPal (cobro online de las reservas). Credenciales de la app REST creada en
# developer.paypal.com. PAYPAL_MODE=sandbox para probar, live para cobrar de
# verdad; con las credenciales del modo que corresponda. Sin estas variables
# la web funciona igual, solo que sin el botón de pago.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

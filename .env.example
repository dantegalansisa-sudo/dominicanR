# Google Places API (New) — solo servidor. Sin prefijo VITE_ para que Vite
# nunca la incluya en el bundle del navegador.
GOOGLE_PLACES_API_KEY=

# Resend, para el formulario de contacto y las reservas.
RESEND_API_KEY=
CONTACT_TO=dominicanroutes@gmail.com
CONTACT_FROM=Dominican Routes <onboarding@resend.dev>

# PayPal (cobro online de las reservas). Credenciales de la app REST creada en
# developer.paypal.com. PAYPAL_MODE=sandbox para probar, live para cobrar de
# verdad; con las credenciales del modo que corresponda. Sin estas variables
# la web funciona igual, solo que sin el botón de pago.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ------------------------------------------------------------------ ETG
# API de traslados para Emerging Travel Group (docs/etg/). Sin usuario y
# contraseña la API no responde. Distintos en staging y en producción.
ETG_ENV=production
ETG_API_USER=
ETG_API_PASSWORD=
# Dominios donde la API responde en la raíz (/search, /book, /status, /cancel).
ETG_API_HOSTS=api.dominicanroutes.com,staging-api.dominicanroutes.com
# Base del enlace de cada orden que recibe ETG (supplier_link).
ETG_PUBLIC_URL=https://dominicanroutes.com
# Opcionales: mandan sobre lo que se ponga en el panel (ETG → Ajustes).
ETG_CURRENCY=USD
ETG_PRICE_MARKUP_PERCENT=0
# Copia diaria de la base en data/backups (0 = desactivada).
DB_DAILY_BACKUP=1
